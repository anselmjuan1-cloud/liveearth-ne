# Which GitHub repo holds the `data` branch that workers write to.
# The deployed app reads registry/health JSON from raw.githubusercontent.com.
NEXT_PUBLIC_GH_OWNER=your-github-username
NEXT_PUBLIC_GH_REPO=liveearth-ne
NEXT_PUBLIC_GH_DATA_BRANCH=data

# Optional. Not required for the MVP -- every data source below is keyless.
# YOUTUBE_API_KEY=
# WINDY_WEBCAMS_KEY=
